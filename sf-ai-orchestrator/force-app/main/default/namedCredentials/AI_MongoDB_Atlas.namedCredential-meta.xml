<?xml version="1.0" encoding="UTF-8"?>
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>AI MongoDB Vercel Proxy</label>
    <!-- Replace YOUR_VERCEL_DOMAIN with your actual Vercel project domain,
         e.g. https://my-salesforce-proxy.vercel.app
         Auth is handled via x-api-key header set in the External Credential Principal.
         The key must match the SALESFORCE_API_KEY environment variable in Vercel. -->
    <endpoint>https://YOUR_VERCEL_DOMAIN.vercel.app</endpoint>
    <principalType>NamedUser</principalType>
    <protocol>NoAuthentication</protocol>
    <allowMergeFieldsInHeader>true</allowMergeFieldsInHeader>
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <generateAuthorizationHeader>false</generateAuthorizationHeader>
</NamedCredential>
