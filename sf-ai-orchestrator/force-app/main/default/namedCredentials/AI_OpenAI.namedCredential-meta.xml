<?xml version="1.0" encoding="UTF-8"?>
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>AI OpenAI</label>
    <endpoint>https://api.openai.com</endpoint>
    <principalType>NamedUser</principalType>
    <protocol>NoAuthentication</protocol>
    <!-- Auth is handled via custom header: Authorization: Bearer {token}
         Set up via External Credential with Custom Auth Parameter.
         Token is stored in Salesforce Secret Manager / External Credential Principal,
         NEVER in Apex code or Custom Fields. -->
    <allowMergeFieldsInHeader>true</allowMergeFieldsInHeader>
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <generateAuthorizationHeader>false</generateAuthorizationHeader>
</NamedCredential>
